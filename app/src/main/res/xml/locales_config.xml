<?xml version="1.0" encoding="utf-8"?>
<!--
    Declares the application languages so Android 13+ can show Atlas X in the
    per-app language picker. The running locale is still applied by
    LocaleHelper so the choice also works below API 33.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="fa" />
</locale-config>
