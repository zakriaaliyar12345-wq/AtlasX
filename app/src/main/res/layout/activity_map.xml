<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    tools:ignore="MergeRootFrame">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/atlas_surface"
        android:elevation="4dp"
        app:title="@string/map_title"
        app:titleTextColor="@color/atlas_text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="?attr/actionBarSize"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:id="@+id/pickHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_info"
            android:gravity="center"
            android:padding="@dimen/spacing_sm"
            android:text="@string/map_pick_hint"
            android:textColor="@color/atlas_navy"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <TextView
            android:id="@+id/offlineBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:padding="@dimen/spacing_sm"
            android:text="@string/map_offline"
            android:textColor="@color/atlas_error"
            android:textSize="@dimen/text_caption"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/measureBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_sm"
            android:visibility="gone">

            <TextView
                android:id="@+id/measureText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/map_measure_start"
                android:textColor="@color/atlas_text_primary"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/measureClear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:paddingLeft="@dimen/spacing_sm"
                android:paddingRight="@dimen/spacing_sm"
                android:text="@string/action_clear_measure"
                android:textColor="@color/atlas_teal"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/coordinateReadout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginEnd="@dimen/screen_padding"
            android:layout_marginBottom="@dimen/spacing_xs"
            android:background="@drawable/bg_card_navy"
            android:maxWidth="300dp"
            android:paddingStart="@dimen/spacing_md"
            android:paddingTop="@dimen/spacing_xs"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingBottom="@dimen/spacing_xs"
            android:textColor="@color/atlas_text_on_dark"
            android:textSize="@dimen/text_caption"
            android:textIsSelectable="true" />

        <include layout="@layout/include_bottom_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/addPointButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="96dp"
        android:layout_marginEnd="@dimen/screen_padding"
        android:contentDescription="@string/cd_add"
        android:src="@drawable/ic_add"
        app:backgroundTint="@color/atlas_teal"
        app:tint="@color/atlas_text_on_dark" />
</FrameLayout>
