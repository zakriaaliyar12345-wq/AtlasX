<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/atlas_surface"
        android:elevation="2dp"
        app:subtitle="@string/analysis_subtitle"
        app:subtitleTextColor="@color/atlas_text_secondary"
        app:title="@string/analysis_title"
        app:titleTextColor="@color/atlas_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Distance tool -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/distance_section"
                    android:textAppearance="@style/TextAppearance.AtlasX.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:text="@string/distance_hint"
                    android:textColor="@color/atlas_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <EditText
                    android:id="@+id/latitudeA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_pill"
                    android:hint="@string/latitude_a"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:textColor="@color/atlas_text_primary"
                    android:textColorHint="@color/atlas_text_secondary" />

                <EditText
                    android:id="@+id/longitudeA"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@drawable/bg_pill"
                    android:hint="@string/longitude_a"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:textColor="@color/atlas_text_primary"
                    android:textColorHint="@color/atlas_text_secondary" />

                <EditText
                    android:id="@+id/latitudeB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@drawable/bg_pill"
                    android:hint="@string/latitude_b"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:textColor="@color/atlas_text_primary"
                    android:textColorHint="@color/atlas_text_secondary" />

                <EditText
                    android:id="@+id/longitudeB"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@drawable/bg_pill"
                    android:hint="@string/longitude_b"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal|numberSigned"
                    android:maxLines="1"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:textColor="@color/atlas_text_primary"
                    android:textColorHint="@color/atlas_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calculateDistance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/action_calculate"
                    app:icon="@drawable/ic_measure"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/distanceResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_pill"
                    android:padding="@dimen/spacing_md"
                    android:text="@string/distance_placeholder"
                    android:textColor="@color/atlas_navy"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Area tool -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/area_section"
                    android:textAppearance="@style/TextAppearance.AtlasX.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:text="@string/area_hint"
                    android:textColor="@color/atlas_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/vertexLatitude"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill"
                        android:hint="@string/vertex_latitude_hint"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal|numberSigned"
                        android:maxLines="1"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingEnd="@dimen/spacing_md"
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textColor="@color/atlas_text_primary"
                        android:textColorHint="@color/atlas_text_secondary" />

                    <EditText
                        android:id="@+id/vertexLongitude"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill"
                        android:hint="@string/vertex_longitude_hint"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal|numberSigned"
                        android:maxLines="1"
                        android:paddingStart="@dimen/spacing_md"
                        android:paddingTop="@dimen/spacing_sm"
                        android:paddingEnd="@dimen/spacing_md"
                        android:paddingBottom="@dimen/spacing_sm"
                        android:textColor="@color/atlas_text_primary"
                        android:textColorHint="@color/atlas_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/addVertex"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/action_add_vertex"
                        android:textSize="13sp"
                        app:icon="@drawable/ic_add"
                        app:iconSize="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearVertices"
                        style="@style/Widget.AtlasX.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_xs"
                        android:layout_weight="1"
                        android:text="@string/action_clear_vertices"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/verticesCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:textColor="@color/atlas_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/verticesText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:background="@drawable/bg_pill"
                    android:padding="@dimen/spacing_md"
                    android:textColor="@color/atlas_text_primary"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/areaResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/area_placeholder"
                    android:textColor="@color/atlas_navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/perimeterResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:textColor="@color/atlas_text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- Coordinate converter -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/converter_section"
                    android:textAppearance="@style/TextAppearance.AtlasX.SectionTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xxs"
                    android:text="@string/converter_hint"
                    android:textColor="@color/atlas_text_secondary"
                    android:textSize="@dimen/text_caption" />

                <RadioGroup
                    android:id="@+id/converterAxis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/axisLatitude"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/field_latitude" />

                    <RadioButton
                        android:id="@+id/axisLongitude"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/field_longitude" />
                </RadioGroup>

                <EditText
                    android:id="@+id/converterInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:background="@drawable/bg_pill"
                    android:hint="@string/converter_input_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="@dimen/spacing_md"
                    android:paddingTop="@dimen/spacing_sm"
                    android:paddingEnd="@dimen/spacing_md"
                    android:paddingBottom="@dimen/spacing_sm"
                    android:textColor="@color/atlas_text_primary"
                    android:textColorHint="@color/atlas_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/convertButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/action_convert"
                    app:icon="@drawable/ic_analysis"
                    app:iconSize="18dp" />

                <TextView
                    android:id="@+id/converterResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:background="@drawable/bg_pill"
                    android:padding="@dimen/spacing_md"
                    android:text="@string/converter_hint"
                    android:textColor="@color/atlas_navy"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
