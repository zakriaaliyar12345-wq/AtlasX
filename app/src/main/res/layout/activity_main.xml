<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/atlas_surface"
        android:elevation="2dp"
        app:menu="@menu/menu_dashboard"
        app:subtitle="@string/dashboard_subtitle"
        app:subtitleTextColor="@color/atlas_text_secondary"
        app:title="@string/dashboard_title"
        app:titleTextColor="@color/atlas_text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/atlas_background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- Brand header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_navy"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/atlas_text_on_dark"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/app_tagline"
                    android:textColor="@color/atlas_teal_bright"
                    android:textSize="13sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/dashboard_welcome"
                    android:textColor="@color/atlas_text_on_navy_soft"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/dashboardSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp"
                    android:text="@string/loading"
                    android:textColor="@color/atlas_text_primary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Real statistics computed from the local database -->
            <TextView
                style="@style/TextAppearance.AtlasX.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/stats_section"
                android:textAppearance="@style/TextAppearance.AtlasX.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/statPointsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0"
                        android:textColor="@color/atlas_navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/stat_points_label"
                        android:textColor="@color/atlas_text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/statProjectsValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="0"
                        android:textColor="@color/atlas_navy"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/stat_projects_label"
                        android:textColor="@color/atlas_text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_sm">

                    <TextView
                        android:id="@+id/statStorageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="—"
                        android:textColor="@color/atlas_navy"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/stat_storage_label"
                        android:textColor="@color/atlas_text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Quick actions -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:text="@string/quick_actions_section"
                android:textAppearance="@style/TextAppearance.AtlasX.SectionTitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionOpenMap"
                    style="@style/Widget.AtlasX.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_open_map"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_map"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionOpenPoints"
                    style="@style/Widget.AtlasX.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/action_open_points"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_pin"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionOpenProjects"
                    style="@style/Widget.AtlasX.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_open_projects"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_layers"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionOpenAnalysis"
                    style="@style/Widget.AtlasX.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/action_open_analysis"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_analysis"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionImportGeoJson"
                    style="@style/Widget.AtlasX.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/action_import_geojson"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_import"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionExportGeoJson"
                    style="@style/Widget.AtlasX.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_xs"
                    android:layout_weight="1"
                    android:text="@string/action_export_geojson"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_export"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="16dp" />
            </LinearLayout>

            <!-- Recent points -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xl"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/recent_section"
                    android:textAppearance="@style/TextAppearance.AtlasX.SectionTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/actionOpenSettings"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="@string/action_open_settings"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_settings"
                    app:iconSize="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/recentEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_card"
                android:padding="@dimen/card_padding"
                android:text="@string/recent_empty"
                android:textColor="@color/atlas_text_secondary"
                android:textSize="@dimen/text_body" />

            <LinearLayout
                android:id="@+id/recentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:orientation="vertical" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_lg" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_bottom_nav" />
</LinearLayout>
